.cssproperties
    - block-margin: 0

.css 
    .entrygrid + .entrygrid { margin-top: 0.35em }

.pageformat margin:{0.5in}
.font size:{12px}
.paragraphstyle spacing:{0}
.nonumbering

.extend {heading} where:{depth: .depth::equals {1}}
    .super margin:{0}

.extend {heading} where:{depth: .depth::equals {2}}
    .super margin:{1em 0 0.5em 0} fontsize:{large}

.function {contactinfo}
    content:
    .row gap:{1em}
        .content::foreach
            .1::text size:{small}

.function {INTERNALentrygrid}
    tl? tr? bl? br? content?:
    .container fullwidth:{yes} classname:{entrygrid}
        .row alignment:{spacebetween}
            .ifnot {.tl::isnone} {.tl}

            .ifnot {.tr::isnone} {.tr}

        .row alignment:{spacebetween}
            .ifnot {.bl::isnone} {.bl}

            .ifnot {.br::isnone} {.br}
    
        .ifnot {.content::isnone} 
            .content    

.function {edu}
    institution degree dates location content?:
    .INTERNALentrygrid tl:{**.institution**} \
                       tr:{*.location*} \
                       bl:{*.degree*} \
                       br:{.dates} \
                       content:{.content}
.function {work}
    title dates company location content?:
    .INTERNALentrygrid tl:{**.title**} \
                       tr:{.dates} \
                       bl:{.company} \
                       br:{*.location*} \
                       content:{.content}

.function {project}
    name role? dates content?:
    .INTERNALentrygrid tl:{.role::ifpresent {**.1,**}::otherwise {} .name} \
                       tr:{.dates} \
                       content:{.content}
