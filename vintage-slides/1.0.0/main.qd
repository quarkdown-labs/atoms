.theme {paperwhite} layout:{hyperlegible}
.pageformat background:{#F4F2ED} alignment:{start}
.font {fonts/DMSans.ttf} heading:{fonts/PlayfairDisplay.ttf}
.autopagebreak {3}

.extend {heading} where:{depth: .depth::equals {1}}
    .super fontsize:{huge}

.cssproperties
    - main-color: #3D3935
    - link-color: #605545

.css 
    :root {
        --slide-scale: 0.75;
    }
    html:not(.reveal-print) .slides,
    html.reveal-print .pdf-page > section {
        border-top: 3px solid var(--qd-main-color);
        border-bottom: 3px solid var(--qd-main-color);
        box-sizing: border-box;
    }
    html:not(.reveal-print) .reveal {
        transform: scale(var(--slide-scale));
    }
    html.reveal-print .reveal .slides .pdf-page > section {
        display: flex !important;
        transform: scale(var(--slide-scale)) !important;
    }
    .progress {
        display: none;
    }
    .reveal .slides section {
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    h1 {
        margin-top: auto;
    }
    h2, h3 {
        margin-top: 1rem;
        margin-bottom: auto;
    }
    section:has(h1, h2, h3) > :last-child {
        margin-bottom: auto;
    }
    section:has(h1, h2) {
        --qd-horizontal-alignment-global: center;
        text-align: var(--qd-horizontal-alignment-global);
    }
    a {
        font-weight: bold;
    }
