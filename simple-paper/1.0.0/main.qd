.include {@atoms/authors-frontmatter:1.0.0}

.pageformat margin:{25mm} padding:{2.25em 0 1.75em 0} bordercolor:{lightgray} bordertop:{1px} borderbottom:{1px}
.pageformat pages:{1..1} bordertop:{0} borderbottom:{1px}

.extend {heading} where:{ref: .ref::equals {title}}
    .super fontsize:{huge} padding:{1em 0 0 0}

.cssproperties
    - link-color: inherit

.css
    [data-page-number="1"] :is(.page-margin-top-left, .page-margin-top-right) {
        font-size: var(--qd-size-medium);
        transform: translateY(1em);
    }

    .pagedjs_margin-top {
        grid-template-columns: repeat(2, 1fr);
    }

    .pagedjs_margin-top-center {
        display: none;
    }
