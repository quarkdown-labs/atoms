.css
    .authors-metadata :not(:first-child) {
        --qd-paragraph-vertical-margin: 0.2em;
    }

.function {authorblock}
    layout? fontsize? fontweight? ids?:
    .var {autoLayoutThreshold} {5}
    .var {ids} {.ids::ifpresent {.1::dictionary}::otherwise {.emptydictionary}}

    .var {info}
        .docauthors::foreach
            author info:
            .var {entryIDs} {.info::get {ids}::ifpresent {.1::split}}
            .var {frontmatterentries} {.ids::withindices::findall {index entry: .entryIDs::contains {.entry::first}}}
        
            {.author}{.frontmatterentries::join separator:{,} body:{.1::first}::text script:{sup} size:{small} weight:{normal}}
    
    .container fontsize:{.fontsize} fontweight:{.fontweight} fullwidth:{yes}
        .info::join

    .if {.ids::size::isgreater than:{0}}
        .container classname:{authors-metadata}
            .var {items}
                .ids::withindices::foreach
                    index entry:
                    {.text {.index} script:{sup}}{.entry::second}
        
            .var {layoutname} {.layout}
            .if {.layout::isnone::or {.layout::equals {auto}}}
                .layoutname {.items::takeif {.1::size::isgreater than:{.autoLayoutThreshold}}::ifpresent {stack}::otherwise fallback:{inline}}
        
            .if {.layoutname::equals {inline}}
                .items::join
            .if {.layoutname::equals {stack}}
                .items