.css 
    .kanban {
        --qd-paragraph-vertical-margin: 0;
        --qd-horizontal-alignment-global: start;
        --qd-horizontal-alignment-local: start;
    }

.function {INTERNALalphaadjust}
    base alpha:
    .base::color alpha:{.alpha}

.function {kanban}
    fontsize? rowgap? labels? content:
    .var {kblabels}
        .labels::otherwise {
            - high: red
            - medium: yellow
            - low: green
        }
    .container fullwidth:{yes} fontsize:{.fontsize} classname:{kanban}
        .row gap:{.rowgap::otherwise {1.5em}} cross:{start}
            .content

.function {kbcolumn}
    text width? color? content:
    .column cross:{stretch} gap:{0.5em} width:{.width::otherwise {12em}} 
        .container margin:{0 0 0.5em 0} border:{.color} borderwidth:{0 0 2px 0}
            **.text**
        .content

.function {kbitem} 
    text color? labels?:
    .container padding:{0.75em 1em} \
               border:{.color::otherwise {lightgray}} borderwidth:{1px} radius:{6px}
        .text

        .ifnot {.labels::isnone}
            .container margin:{0.25em 0 0 0}
                .row gap:{0.5em}
                    .labels::foreach
                        label:
                        .container background:{.kblabels::get {.label::lowercase}::otherwise {lightgray}::INTERNALalphaadjust {0.25}} \
                                   padding:{0.2em 0.5em} radius:{2px} fontsize:{small}
                            .label
